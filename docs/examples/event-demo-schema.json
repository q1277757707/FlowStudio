{
  "pageId": "page_event_demo",
  "pageName": "事件配置示例页",
  "pageEvents": {
    "pageLoad": [
      {
        "id": "page_load_msg",
        "action": "message",
        "config": {
          "type": "info",
          "content": "欢迎！这是 pageLoad 示例，仅在打开预览时执行一次。"
        }
      }
    ]
  },
  "components": [
    {
      "id": "input_source",
      "type": "Input",
      "props": {
        "label": "输入 A（源）",
        "placeholder": "在这里输入，会同步到输入 B"
      },
      "events": {
        "change": [
          {
            "id": "act_mirror_field",
            "action": "customJS",
            "config": {
              "code": "form['input_mirror'] = event.value"
            }
          }
        ]
      }
    },
    {
      "id": "input_mirror",
      "type": "Input",
      "props": {
        "label": "输入 B（同步显示）",
        "placeholder": "内容由输入 A 同步"
      }
    },
    {
      "id": "select_mode",
      "type": "Select",
      "props": {
        "label": "模式",
        "placeholder": "请选择",
        "options": [
          { "label": "A", "value": "A" },
          { "label": "B", "value": "B" }
        ],
        "multiple": false,
        "defaultValue": "A"
      },
      "events": {
        "change": [
          {
            "id": "act_toggle_detail",
            "action": "condition",
            "config": {
              "expression": "{{event.value}} === 'A'",
              "trueActions": [
                {
                  "action": "setVisible",
                  "config": { "componentId": "input_detail", "visible": true }
                }
              ],
              "falseActions": [
                {
                  "action": "setVisible",
                  "config": { "componentId": "input_detail", "visible": false }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "input_detail",
      "type": "Input",
      "props": {
        "label": "详情（仅选 A 时显示）",
        "placeholder": "请输入详情"
      }
    },
    {
      "id": "select_status",
      "type": "Select",
      "props": {
        "label": "状态",
        "placeholder": "请选择状态",
        "options": [
          { "label": "草稿", "value": "draft" },
          { "label": "已发布", "value": "published" }
        ],
        "multiple": false
      },
      "events": {
        "change": [
          {
            "id": "act_select_demo_api",
            "action": "request",
            "config": {
              "url": "/api/demo",
              "method": "POST",
              "params": {
                "status": "{{event.value}}"
              }
            }
          },
          {
            "id": "act_select_message",
            "action": "message",
            "config": {
              "type": "success",
              "content": "已选状态：{{event.value}}，接口已调用"
            }
          }
        ]
      }
    },
    {
      "id": "input_user_name",
      "type": "Input",
      "props": {
        "label": "姓名",
        "placeholder": "请输入姓名"
      },
      "events": {
        "change": [
          {
            "id": "act_set_user_name",
            "action": "setVariable",
            "config": {
              "key": "userName",
              "value": "{{event.value}}"
            }
          },
          {
            "id": "act_name_message",
            "action": "message",
            "config": {
              "type": "success",
              "content": "已记录：{{variables.userName}}"
            }
          }
        ],
        "blur": [
          {
            "id": "act_blur_check",
            "action": "condition",
            "config": {
              "expression": "{{event.value}}",
              "trueActions": [
                {
                  "action": "message",
                  "config": {
                    "type": "info",
                    "content": "失焦时姓名：{{event.value}}"
                  }
                }
              ],
              "falseActions": [
                {
                  "action": "message",
                  "config": {
                    "type": "warning",
                    "content": "姓名不能为空"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "btn_submit",
      "type": "Button",
      "props": {
        "text": "提交",
        "type": "primary"
      },
      "events": {
        "click": [
          {
            "id": "act_confirm",
            "action": "dialog",
            "config": {
              "type": "confirm",
              "title": "确认提交",
              "message": "将提交姓名：{{variables.userName}}，是否继续？"
            }
          },
          {
            "id": "act_branch_submit",
            "action": "condition",
            "config": {
              "expression": "{{variables.dialogResult}}",
              "trueActions": [
                {
                  "action": "request",
                  "config": {
                    "url": "https://jsonplaceholder.typicode.com/posts",
                    "method": "POST",
                    "params": {
                      "title": "{{variables.userName}}",
                      "body": "低代码事件示例提交",
                      "userId": 1
                    }
                  }
                },
                {
                  "action": "message",
                  "config": {
                    "type": "success",
                    "content": "提交成功（演示接口）"
                  }
                }
              ],
              "falseActions": [
                {
                  "action": "message",
                  "config": {
                    "type": "info",
                    "content": "已取消提交"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "btn_demo_chain",
      "type": "Button",
      "props": {
        "text": "演示：延迟 + 消息",
        "type": "default"
      },
      "events": {
        "click": [
          {
            "id": "act_delay",
            "action": "delay",
            "config": {
              "ms": 600
            }
          },
          {
            "id": "act_delayed_msg",
            "action": "message",
            "config": {
              "type": "success",
              "content": "延迟 600ms 后显示本条消息"
            }
          }
        ]
      }
    }
  ]
}
